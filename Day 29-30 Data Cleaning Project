CREATE DATABASE cleaning_project_1;

USE cleaning_project_1;

SHOW TABLES;
CREATE TABLE order_raw(
order_id VARCHAR(50),
Customer_name VARCHAR(50),
Email VARCHAR(40),
City VARCHAR (20),
order_date VARCHAR (20),
Amount VARCHAR (20)
);
DROP TABLE IF EXISTS Orders_cleaned;
CREATE TABLE Orders_cleaned AS                -- Creates a new table called orders_cleaned and copy all of the data from the orders_raw into it  
SELECT *
FROM order_raw;

SELECT * FROM Orders_cleaned;

 -- 1. How to detect duplicate records in the Orders table? 
 SELECT customer_name, email, city, Count(*)
 FROM Orders_cleaned
 GROUP BY customer_name, email, city
 HAVING COUNT(*) > 1;
 
--  2.How to remove duplicate records while keeping the original one?  
DELETE FROM Orders_cleaned
WHERE order_id IN (
    SELECT order_id
    FROM (
        SELECT order_id, ROW_NUMBER() OVER (PARTITION BY Customer_name, email, city, amount
                   ORDER BY order_id
               ) AS rn
        FROM Orders_cleaned) AS t
    WHERE rn > 1
);
                    
--  3.How to find customers with NULL email addresses? 
SELECT * FROM orders_cleaned WHERE Email IS NULL; 
                              
--  4.How to replace missing NULL emails with 'unknown@gmail.com'?
      UPDATE Orders_cleaned 
      SET Email = 'unknown@gmail.com'
      WHERE Email IS NULL ;
      SELECT * FROM Orders_cleaned;
      
--  5.How to detect invalid email addresses?
          SELECT * FROM Orders_cleaned
          WHERE Email NOT LIKE '%@%.%';
          
